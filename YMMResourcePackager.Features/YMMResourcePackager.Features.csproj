<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>hazimeyou</Authors>
    <Description>Feature bridge for YmmpxLib-backed pack and unpack operations.</Description>
    <RepositoryUrl>https://github.com/hazimeyou/YMMResourcePackager</RepositoryUrl>
    <PackageProjectUrl>https://github.com/hazimeyou/YMMResourcePackager</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 hazimeyou</Copyright>
    <Version Condition="'$(Version)'==''">1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\YMMResourcePackager.Shared\YMMResourcePackager.Shared.csproj" />
    <Reference Include="YmmpxLibV2">
      <HintPath>$(YMM4_PATH)\user\plugin\YmmpxLibV2Plugin\YmmpxLibV2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireYmmpxLibV2" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(YMM4_PATH)\user\plugin\YmmpxLibV2Plugin\YmmpxLibV2.dll')"
           Text="YmmpxLibV2.dll が見つかりません。YmmpxLibV2Plugin を YMM4 の user\\plugin\\YmmpxLibV2Plugin に導入してください。" />
  </Target>
</Project>
