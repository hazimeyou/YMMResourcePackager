<UserControl x:Class="YMMResourcePackagerPlugin.View.ToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="550"
             Width="420">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10" VerticalAlignment="Top">
            <TextBlock Text="素材同梱プラグイン" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Content="ファイルから選択"
                        Command="{Binding SelectProjectCommand}"
                        Margin="0,0,0,5"
                        HorizontalAlignment="Stretch"/>
                <Button Grid.Row="1"
                        Content="現在開いているプロジェクトを使用"
                        Command="{Binding UseOpenedProjectCommand}"
                        HorizontalAlignment="Stretch"/>
            </Grid>

            <TextBox Text="{Binding SelectedProject}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10"/>

            <CheckBox Content="プロジェクトUI設定を含める (LayoutXml / ToolStates)"
                      IsChecked="{Binding IncludeProjectUiSettings}"
                      Margin="0,0,0,8"/>

            <Button Content="同梱 / 展開"
                    Command="{Binding PackageCommand}"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Stretch"/>
            <Button Content="除外素材を設定"
                    Command="{Binding OpenExcludeSettingCommand}"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Stretch"/>
            <ProgressBar Value="{Binding Progress}"
                         Minimum="0"
                         Maximum="100"
                         Height="20"/>

            <TextBlock Margin="0,8,0,0"
                       Text="{Binding DetectedMaterialCount, StringFormat=検出素材数: {0}}"/>
            <TextBlock Text="{Binding ExcludedMaterialCount, StringFormat=除外数: {0}}"/>
            <TextBlock Text="{Binding MissingMaterialCount, StringFormat=見つからない素材数: {0}}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <Button Content=".ymmpx 関連付けを設定"
                    Command="{Binding AssociateYmmpxCommand}"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Stretch"/>
            <Button Content="YmmpxLib をインストール"
                    Command="{Binding InstallYmmpxLibCommand}"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"/>

            <TextBlock Text=".ymmpx 展開先" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding UnpackOutputOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedUnpackOutputMode}"
                      Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding CustomUnpackDirectory}"
                         IsEnabled="{Binding IsCustomUnpackDirectoryEnabled}"
                         Margin="0,0,5,0"/>
                <Button Grid.Column="1"
                        Content="参照"
                        Command="{Binding BrowseCustomUnpackDirectoryCommand}"
                        IsEnabled="{Binding IsCustomUnpackDirectoryEnabled}"/>
            </Grid>

            <CheckBox Content="ログを有効化"
                      IsChecked="{Binding EnableLogging}"
                      Margin="0,0,0,8"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Content="ログフォルダを開く"
                        Command="{Binding OpenLogFolderCommand}"
                        Margin="0,0,0,5"
                        HorizontalAlignment="Stretch"/>
                <Button Grid.Row="1"
                        Content="最新ログを開く"
                        Command="{Binding OpenLatestLogCommand}"
                        HorizontalAlignment="Stretch"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
