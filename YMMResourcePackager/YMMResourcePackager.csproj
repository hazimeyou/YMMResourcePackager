<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version Condition="'$(Version)'==''">0.0.0</Version>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(YMM4_PATH)\YukkuriMovieMaker.Plugin.dll')">
    <Reference Include="YukkuriMovieMaker.Plugin"
           HintPath="$(YMM4_PATH)\YukkuriMovieMaker.Plugin.dll"
           Private="false" ExcludeAssets="runtime" />
    <Reference Include="YukkuriMovieMaker.Controls"
           HintPath="$(YMM4_PATH)\YukkuriMovieMaker.Controls.dll"
           Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(YMM4_PATH)\YukkuriMovieMaker.Plugin.dll')">
    <Reference Include="YukkuriMovieMaker.Plugin"
           HintPath="..\libs\YukkuriMovieMaker.Plugin.dll"
           Private="false" ExcludeAssets="runtime" />
    <Reference Include="YukkuriMovieMaker.Controls"
           HintPath="..\libs\YukkuriMovieMaker.Controls.dll"
           Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YMMResourcePackager.Shared\YMMResourcePackager.Shared.csproj" />
  </ItemGroup>

  <Target Name="BuildFeatures" BeforeTargets="Build">
    <MSBuild
      Projects="..\YMMResourcePackager.Features\YMMResourcePackager.Features.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Version=$(Version)" />
  </Target>

  <Target Name="BuildUnpacker" BeforeTargets="Build">
    <MSBuild
      Projects="..\YMMResourceUnpackerApp\YMMResourceUnpackerApp.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Version=$(Version)" />
  </Target>

  <Target Name="CopyArtifactsToOutput" AfterTargets="Build">
    <PropertyGroup>
      <FeaturesOutputPath>$(MSBuildThisFileDirectory)..\YMMResourcePackager.Features\bin\$(Configuration)\net10.0-windows\YMMResourcePackager.Features.dll</FeaturesOutputPath>
      <SharedOutputPath>$(MSBuildThisFileDirectory)..\YMMResourcePackager.Shared\bin\$(Configuration)\net10.0\YMMResourcePackager.Shared.dll</SharedOutputPath>
      <UnpackerExeOutputPath>$(MSBuildThisFileDirectory)..\YMMResourceUnpackerApp\bin\$(Configuration)\net10.0\win-x64\publish\YMMResourceUnpackerApp.exe</UnpackerExeOutputPath>
      <UnpackerDllOutputPath>$(MSBuildThisFileDirectory)..\YMMResourceUnpackerApp\bin\$(Configuration)\net10.0\win-x64\YMMResourceUnpackerApp.dll</UnpackerDllOutputPath>
      <UnpackerRuntimeConfigOutputPath>$(MSBuildThisFileDirectory)..\YMMResourceUnpackerApp\bin\$(Configuration)\net10.0\win-x64\YMMResourceUnpackerApp.runtimeconfig.json</UnpackerRuntimeConfigOutputPath>
    </PropertyGroup>

    <Copy SourceFiles="$(FeaturesOutputPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(FeaturesOutputPath)')" />
    <Copy SourceFiles="$(SharedOutputPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(SharedOutputPath)')" />
    <Copy SourceFiles="$(UnpackerExeOutputPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(UnpackerExeOutputPath)')" />
    <Copy SourceFiles="$(UnpackerDllOutputPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(UnpackerDllOutputPath)')" />
    <Copy SourceFiles="$(UnpackerRuntimeConfigOutputPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(UnpackerRuntimeConfigOutputPath)')" />

    <Delete Files="$(TargetDir)YmmpxLib.dll" Condition="Exists('$(TargetDir)YmmpxLib.dll')" />
    <Delete Files="$(TargetDir)YmmpxLib.deps.json" Condition="Exists('$(TargetDir)YmmpxLib.deps.json')" />
  </Target>

  <Target Name="CopyToYMM4" AfterTargets="Build" Condition="Exists('$(YMM4_PATH)')">
    <PropertyGroup>
      <PluginOutputDir>$(YMM4_PATH)\user\plugin\$(AssemblyName)</PluginOutputDir>
      <FeaturesOutputPath>$(MSBuildThisFileDirectory)..\YMMResourcePackager.Features\bin\$(Configuration)\net10.0-windows\YMMResourcePackager.Features.dll</FeaturesOutputPath>
      <SharedOutputPath>$(MSBuildThisFileDirectory)..\YMMResourcePackager.Shared\bin\$(Configuration)\net10.0\YMMResourcePackager.Shared.dll</SharedOutputPath>
      <UnpackerExeOutputPath>$(MSBuildThisFileDirectory)..\YMMResourceUnpackerApp\bin\$(Configuration)\net10.0\win-x64\publish\YMMResourceUnpackerApp.exe</UnpackerExeOutputPath>
      <UnpackerDllOutputPath>$(MSBuildThisFileDirectory)..\YMMResourceUnpackerApp\bin\$(Configuration)\net10.0\win-x64\YMMResourceUnpackerApp.dll</UnpackerDllOutputPath>
      <UnpackerRuntimeConfigOutputPath>$(MSBuildThisFileDirectory)..\YMMResourceUnpackerApp\bin\$(Configuration)\net10.0\win-x64\YMMResourceUnpackerApp.runtimeconfig.json</UnpackerRuntimeConfigOutputPath>
    </PropertyGroup>

    <MakeDir Directories="$(PluginOutputDir)" Condition="!Exists('$(PluginOutputDir)')" />

    <ItemGroup>
      <PluginFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).deps.json" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
      <PluginFiles Include="$(SharedOutputPath)" Condition="Exists('$(SharedOutputPath)')" />
      <PluginFiles Include="$(FeaturesOutputPath)" Condition="Exists('$(FeaturesOutputPath)')" />
      <PluginFiles Include="$(UnpackerExeOutputPath)" Condition="Exists('$(UnpackerExeOutputPath)')" />
      <PluginFiles Include="$(UnpackerDllOutputPath)" Condition="Exists('$(UnpackerDllOutputPath)')" />
      <PluginFiles Include="$(UnpackerRuntimeConfigOutputPath)" Condition="Exists('$(UnpackerRuntimeConfigOutputPath)')" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginOutputDir)" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />

    <Delete Files="$(PluginOutputDir)\YmmpxLib.dll" Condition="Exists('$(PluginOutputDir)\YmmpxLib.dll')" />
    <Delete Files="$(PluginOutputDir)\YmmpxLib.deps.json" Condition="Exists('$(PluginOutputDir)\YmmpxLib.deps.json')" />
  </Target>

</Project>
