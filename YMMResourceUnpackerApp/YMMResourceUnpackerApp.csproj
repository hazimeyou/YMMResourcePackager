<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version Condition="'$(Version)'==''">0.0.0</Version>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishSelfContained>true</PublishSelfContained>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<YMM4_PATH>C:\Users\yu-za-hazimeyou\Desktop\YukkuriMovieMaker_v4_Lite</YMM4_PATH>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>None</DebugType>
	</PropertyGroup>
	<Target Name="CopyDebugToYMM4" AfterTargets="Build"
			Condition="Exists('$(YMM4_PATH)') and '$(Configuration)' != 'Release'">

		<!-- コピー先フォルダ -->
		<PropertyGroup>
			<PluginOutputDir>
				$(YMM4_PATH)\user\plugin\YMMResourcePackager
			</PluginOutputDir>
		</PropertyGroup>

		<!-- フォルダ作成 -->
		<MakeDir Directories="$(PluginOutputDir)"
				 Condition="!Exists('$(PluginOutputDir)')" />

		<!-- Debug は通常ビルド成果物をコピー -->
		<ItemGroup>
			<PluginFiles Include="$(TargetDir)$(AssemblyName).dll" />
			<PluginFiles Include="$(TargetDir)$(AssemblyName).exe" />
		</ItemGroup>

		<!-- コピー -->
		<Copy SourceFiles="@(PluginFiles)"
			  DestinationFolder="$(PluginOutputDir)" />
	</Target>

	<Target Name="CopyReleasePublishToYMM4" AfterTargets="Publish"
			Condition="Exists('$(YMM4_PATH)') and '$(Configuration)' == 'Release'">

		<!-- コピー先フォルダ -->
		<PropertyGroup>
			<PluginOutputDir>
				$(YMM4_PATH)\user\plugin\YMMResourcePackager
			</PluginOutputDir>
		</PropertyGroup>

		<!-- フォルダ作成 -->
		<MakeDir Directories="$(PluginOutputDir)"
				 Condition="!Exists('$(PluginOutputDir)')" />

		<!-- 以前の Unpacker 配布残骸を削除して単一EXE構成にする -->
		<ItemGroup>
			<PluginDirFiles Include="$(PluginOutputDir)\*.*" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourcePackager.dll" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourcePackager.pdb" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourcePackager.deps.json" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourceUnpackerApp.exe" />
			<StalePluginFiles Include="@(PluginDirFiles)"
							  Exclude="@(KeepPluginFiles)" />
		</ItemGroup>
		<Delete Files="@(StalePluginFiles)" ContinueOnError="true" />

		<!-- Release は publish 成果物（単一EXE, ランタイム同梱）をコピー -->
		<ItemGroup>
			<PluginFiles Include="$(PublishDir)$(AssemblyName).exe" />
		</ItemGroup>

		<!-- コピー -->
		<Copy SourceFiles="@(PluginFiles)"
			  DestinationFolder="$(PluginOutputDir)" />
	</Target>
</Project>
