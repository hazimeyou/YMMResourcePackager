<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version Condition="'$(Version)'==''">0.0.0</Version>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishSelfContained>true</PublishSelfContained>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>None</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\YmmpxLib\YmmpxLib.csproj" />
	</ItemGroup>

	<Target Name="CopyDebugToYMM4" AfterTargets="Build"
			Condition="Exists('$(YMM4_PATH)') and '$(Configuration)' != 'Release'">

		<PropertyGroup>
			<PluginOutputDir>
				$(YMM4_PATH)\user\plugin\YMMResourcePackager
			</PluginOutputDir>
		</PropertyGroup>

		<MakeDir Directories="$(PluginOutputDir)"
				 Condition="!Exists('$(PluginOutputDir)')" />

		<ItemGroup>
			<PluginFiles Include="$(TargetDir)$(AssemblyName).exe" />
			<PluginFiles Include="$(TargetDir)YMMResourcePackager.YmmpxLib.dll"
						 Condition="Exists('$(TargetDir)YMMResourcePackager.YmmpxLib.dll')" />
		</ItemGroup>

		<Copy SourceFiles="@(PluginFiles)"
			  DestinationFolder="$(PluginOutputDir)" />
	</Target>

	<Target Name="CopyReleasePublishToYMM4" AfterTargets="Publish"
			Condition="Exists('$(YMM4_PATH)') and '$(Configuration)' == 'Release'">

		<PropertyGroup>
			<PluginOutputDir>
				$(YMM4_PATH)\user\plugin\YMMResourcePackager
			</PluginOutputDir>
		</PropertyGroup>

		<MakeDir Directories="$(PluginOutputDir)"
				 Condition="!Exists('$(PluginOutputDir)')" />

		<ItemGroup>
			<PluginDirFiles Include="$(PluginOutputDir)\*.*" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourcePackager.dll" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourcePackager.YmmpxLib.dll" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourcePackager.pdb" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourcePackager.deps.json" />
			<KeepPluginFiles Include="$(PluginOutputDir)\YMMResourceUnpackerApp.exe" />
			<StalePluginFiles Include="@(PluginDirFiles)"
							  Exclude="@(KeepPluginFiles)" />
		</ItemGroup>
		<Delete Files="@(StalePluginFiles)" ContinueOnError="true" />

		<ItemGroup>
			<PluginFiles Include="$(PublishDir)$(AssemblyName).exe" />
		</ItemGroup>

		<Copy SourceFiles="@(PluginFiles)"
			  DestinationFolder="$(PluginOutputDir)" />
	</Target>

	<Target Name="PublishReleaseForYMMOnBuild"
			AfterTargets="Build"
			Condition="Exists('$(YMM4_PATH)') and '$(Configuration)' == 'Release' and '$(_ReleaseBuildPublishDone)' != 'true'">
		<MSBuild Projects="$(MSBuildProjectFullPath)"
				 Targets="Publish"
				 Properties="Configuration=$(Configuration);
							 RuntimeIdentifier=$(RuntimeIdentifier);
							 PublishSingleFile=$(PublishSingleFile);
							 PublishSelfContained=$(PublishSelfContained);
							 SelfContained=$(SelfContained);
							 EnableCompressionInSingleFile=$(EnableCompressionInSingleFile);
							 NoBuild=true;
							 YMM4_PATH=$(YMM4_PATH);
							 _ReleaseBuildPublishDone=true" />
	</Target>
</Project>
